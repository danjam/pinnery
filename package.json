{
  "name": "pinnery",
  "version": "0.5.1",
  "description": "Self-hosted image boards with accounts and sharing",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p . && tsc -p src/public && tsc -p tsconfig.sw.json && tsc -p extension",
    "prestart": "npm run build",
    "start": "node src/server.ts",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "precoverage": "npm run build && node -e \"fs.mkdirSync('coverage', { recursive: true })\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include-all --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/public/**\" --test-coverage-exclude=\"src/**/*.d.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=coverage/report.txt --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\"",
    "pree2e": "npm run build",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "nodemailer": "10.6.1",
    "openid-client": "^6.9.0",
    "request-filtering-agent": "^3.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
