{
  "name": "pinnery",
  "version": "0.4.0",
  "description": "Self-hosted image boards with accounts and sharing",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p . && tsc -p src/public && tsc -p tsconfig.sw.json && tsc -p extension",
    "prestart": "npm run build",
    "start": "node src/server.ts",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "coverage": "c8 npm test",
    "pree2e": "npm run build",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "nodemailer": "10.5.0",
    "request-filtering-agent": "^3.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "test-exclude": {
      "minimatch": "^11.0.1"
    }
  }
}
