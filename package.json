{
  "name": "pinnery",
  "version": "0.2.0",
  "description": "Self-hosted single-user image boards",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p . && tsc -p src/public && tsc -p tsconfig.sw.json && tsc -p extension",
    "prestart": "npm run build",
    "start": "node src/server.ts",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "nodemailer": "10.3.1",
    "request-filtering-agent": "^3.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
