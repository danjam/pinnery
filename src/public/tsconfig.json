{
  // The web app's scripts, bundled for the browser by scripts/build.ts.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    // Until the scripts are converted: their .js is accepted but not checked.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["."]
}
